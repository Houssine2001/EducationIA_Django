# Fichiers Python compilés
__pycache__/
*.py[cod]
*.so

# Environnement virtuel
venv/
env/
ENV/

# Fichiers de base de données SQLite
*.sqlite3
db.sqlite3

# Fichiers sensibles
*.env
.env
.env.local
.env.production

# Fichiers de logs
*.log

# Caches et fichiers temporaires
*.pot
*.pyc
*.pyo
*.pyd
*.db
*.mo

# Dossier de migrations (optionnel si tu veux les recréer)
*/migrations/__pycache__/

# Dossier statique généré (collectstatic)
staticfiles/
media/

# Fichiers IDE (VSCode, PyCharm…)
.vscode/
.idea/
*.swp
*.swo

# Fichiers système
.DS_Store
Thumbs.db

# Docker (plus nécessaire pour Render)
*.dockerfile
docker-compose*.yml

# Azure (plus nécessaire)
appsettings.json
azure-*.json
*.zip

