# ===================================
# Variables d'environnement pour Render
# ===================================

# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-here-change-this
DEBUG=0

# MongoDB Atlas Configuration
USE_MONGO=1
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster
MONGO_DB_NAME=django_education

# Hugging Face API (Optionnel - pour analyse IA)
HUGGINGFACE_API_TOKEN=your-huggingface-token-here

# Python Configuration
PYTHON_VERSION=3.11.0
