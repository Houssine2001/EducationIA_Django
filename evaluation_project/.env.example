# ========================================
# EXEMPLE DE FICHIER .env
# Copiez ce fichier en .env et modifiez les valeurs
# ========================================

# Django Settings
SECRET_KEY=django-insecure-changez-cette-clé-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_NAME=evaluation_db

# Authentification MongoDB (décommentez si nécessaire)
# MONGODB_USERNAME=votre_username
# MONGODB_PASSWORD=votre_password
# MONGODB_AUTH_SOURCE=admin
# MONGODB_AUTH_MECHANISM=SCRAM-SHA-1

# Email Configuration (optionnel)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre_email@gmail.com
# EMAIL_HOST_PASSWORD=votre_mot_de_passe

# IA/ML Configuration (optionnel)
# AI_MODEL_PATH=path/to/models/
# AI_CONFIDENCE_THRESHOLD=0.85

# Logging
# LOG_LEVEL=INFO
# LOG_FILE=logs/django.log
