# Configuration MongoDB pour Django

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=django_education
MONGO_USERNAME=
MONGO_PASSWORD=

# Si vous utilisez MongoDB Atlas (cloud)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/django_education?retryWrites=true&w=majority

# Garder Django secret key
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
