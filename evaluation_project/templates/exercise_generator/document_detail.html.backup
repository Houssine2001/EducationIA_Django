{% extends 'base.html' %}
{% load static %}

{% block title %}{{ document.title }} - Détails{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- En-tête -->
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
            <i class="fas fa-file-alt text-blue-600"></i> {{ document.title }}
        </h1>
        <div class="flex space-x-3">
            <a href="{% url 'exercise_generator:document_list' %}" 
               class="inline-flex items-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
                <i class="fas fa-arrow-left mr-2"></i> Retour
            </a>
            <a href="{% url 'exercise_generator:document_reprocess' document.pk %}" 
               class="inline-flex items-center px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors">
                <i class="fas fa-sync mr-2"></i> Re-générer
            </a>
            <a href="{% url 'exercise_generator:test_create' document.pk %}" 
               class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                <i class="fas fa-plus mr-2"></i> Créer un Test
            </a>
        </div>
    </div>
            
            <!-- Informations du document -->
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-info-circle"></i> Informations</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Matière :</dt>
                                <dd class="col-sm-9"><span class="badge badge-primary">{{ document.subject }}</span></dd>
                                
                                <dt class="col-sm-3">Sujet :</dt>
                                <dd class="col-sm-9">{{ document.topic|default:"Non spécifié" }}</dd>
                                
                                <dt class="col-sm-3">Niveau :</dt>
                                <dd class="col-sm-9">{{ document.level|default:"Non spécifié" }}</dd>
                                
                                <dt class="col-sm-3">Type :</dt>
                                <dd class="col-sm-9">{{ document.get_document_type_display }}</dd>
                                
                                <dt class="col-sm-3">Statut :</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-{% if document.processing_status == 'completed' %}success{% elif document.processing_status == 'processing' %}warning{% elif document.processing_status == 'failed' %}danger{% else %}secondary{% endif %}">
                                        {{ document.get_processing_status_display }}
                                    </span>
                                </dd>
                                
                                <dt class="col-sm-3">Créé le :</dt>
                                <dd class="col-sm-9">{{ document.created_at|date:"d/m/Y à H:i" }}</dd>
                            </dl>
                            
                            {% if document.description %}
                            <hr>
                            <p><strong>Description :</strong> {{ document.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-chart-bar"></i> Statistiques</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Mots :</strong> {{ document.word_count }}</p>
                            <p><strong>Phrases :</strong> {{ document.sentence_count }}</p>
                            <p><strong>Exercices générés :</strong> {{ exercise_stats.total }}</p>
                            
                            <hr>
                            
                            <h6>Par type :</h6>
                            <ul>
                                <li>QCM : {{ exercise_stats.mcq }}</li>
                                <li>Vrai/Faux : {{ exercise_stats.true_false }}</li>
                                <li>Texte à trous : {{ exercise_stats.fill_blank }}</li>
                            </ul>
                            
                            <hr>
                            
                            <h6>Par statut :</h6>
                            <ul>
                                <li>Validés : <span class="badge badge-success">{{ exercise_stats.validated }}</span></li>
                                <li>Brouillon : <span class="badge badge-warning">{{ exercise_stats.draft }}</span></li>
                                <li>Rejetés : <span class="badge badge-danger">{{ exercise_stats.rejected }}</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Analyse IA -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-brain"></i> Analyse IA du Document</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>Concepts Clés Identifiés :</h6>
                                    {% if document.key_concepts %}
                                    <div class="mb-3">
                                        {% for concept in document.key_concepts %}
                                        <span class="badge badge-info mr-1 mb-1">{{ concept }}</span>
                                        {% endfor %}
                                    </div>
                                    {% else %}
                                    <p class="text-muted">Aucun concept extrait.</p>
                                    {% endif %}
                                </div>
                                
                                <div class="col-md-6">
                                    <h6>Thèmes Principaux :</h6>
                                    {% if document.main_topics %}
                                    <div class="mb-3">
                                        {% for topic in document.main_topics %}
                                        <span class="badge badge-success mr-1 mb-1">{{ topic }}</span>
                                        {% endfor %}
                                    </div>
                                    {% else %}
                                    <p class="text-muted">Aucun thème identifié.</p>
                                    {% endif %}
                                </div>
                            </div>
                            
                            {% if document.summary %}
                            <hr>
                            <h6>Résumé Automatique :</h6>
                            <p class="text-justify">{{ document.summary }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Exercices générés -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-list"></i> Exercices Générés ({{ exercise_stats.total }})</h5>
                        </div>
                        <div class="card-body">
                            {% if page_obj %}
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th>Concept</th>
                                            <th>Question</th>
                                            <th>Difficulté</th>
                                            <th>Qualité</th>
                                            <th>Statut</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for exercise in page_obj %}
                                        <tr>
                                            <td>
                                                <span class="badge badge-primary">
                                                    {{ exercise.get_exercise_type_display }}
                                                </span>
                                            </td>
                                            <td>{{ exercise.concept }}</td>
                                            <td>{{ exercise.question_text|truncatewords:10 }}</td>
                                            <td>
                                                <span class="badge badge-{% if exercise.difficulty == 'easy' %}success{% elif exercise.difficulty == 'medium' %}warning{% else %}danger{% endif %}">
                                                    {{ exercise.get_difficulty_display }}
                                                </span>
                                            </td>
                                            <td>{{ exercise.quality_score|floatformat:2 }}</td>
                                            <td>
                                                <span class="badge badge-{% if exercise.status == 'validated' %}success{% elif exercise.status == 'published' %}info{% elif exercise.status == 'rejected' %}danger{% else %}secondary{% endif %}">
                                                    {{ exercise.get_status_display }}
                                                </span>
                                            </td>
                                            <td>
                                                <a href="{% url 'exercise_generator:exercise_detail' exercise.pk %}" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Pagination -->
                            {% if page_obj.has_other_pages %}
                            <nav>
                                <ul class="pagination">
                                    {% if page_obj.has_previous %}
                                    <li class="page-item">
                                        <a class="page-link" href="?page={{ page_obj.previous_page_number }}">Précédent</a>
                                    </li>
                                    {% endif %}
                                    
                                    {% for num in page_obj.paginator.page_range %}
                                    <li class="page-item {% if page_obj.number == num %}active{% endif %}">
                                        <a class="page-link" href="?page={{ num }}">{{ num }}</a>
                                    </li>
                                    {% endfor %}
                                    
                                    {% if page_obj.has_next %}
                                    <li class="page-item">
                                        <a class="page-link" href="?page={{ page_obj.next_page_number }}">Suivant</a>
                                    </li>
                                    {% endif %}
                                </ul>
                            </nav>
                            {% endif %}
                            {% else %}
                            <p class="text-muted">Aucun exercice généré pour ce document.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
