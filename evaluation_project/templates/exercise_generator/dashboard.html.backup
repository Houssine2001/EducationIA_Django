{% extends 'base.html' %}
{% load static %}

{% block title %}Générateur d'Exercices IA - Dashboard{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">
                <i class="fas fa-robot"></i> Générateur d'Exercices IA
            </h1>
            
            <!-- Statistiques -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h5 class="card-title">Documents</h5>
                            <h2>{{ stats.total_documents }}</h2>
                            <p class="card-text">Documents analysés</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title">Exercices</h5>
                            <h2>{{ stats.total_exercises }}</h2>
                            <p class="card-text">Exercices générés</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h5 class="card-title">Tests</h5>
                            <h2>{{ stats.total_tests }}</h2>
                            <p class="card-text">Tests créés</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <h5 class="card-title">Validés</h5>
                            <h2>{{ stats.validated_exercises }}</h2>
                            <p class="card-text">Exercices validés</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Actions rapides -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-bolt"></i> Actions Rapides</h5>
                        </div>
                        <div class="card-body">
                            <div class="btn-group" role="group">
                                <a href="{% url 'exercise_generator:document_create' %}" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Nouveau Document
                                </a>
                                <a href="{% url 'exercise_generator:quick_generate' %}" class="btn btn-success">
                                    <i class="fas fa-magic"></i> Génération Rapide
                                </a>
                                <a href="{% url 'exercise_generator:exercise_list' %}" class="btn btn-info">
                                    <i class="fas fa-list"></i> Tous les Exercices
                                </a>
                                <a href="{% url 'exercise_generator:config' %}" class="btn btn-secondary">
                                    <i class="fas fa-cog"></i> Configuration
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Documents récents -->
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-file-alt"></i> Documents Récents</h5>
                        </div>
                        <div class="card-body">
                            {% if recent_documents %}
                            <div class="list-group">
                                {% for doc in recent_documents %}
                                <a href="{% url 'exercise_generator:document_detail' doc.pk %}" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">{{ doc.title }}</h6>
                                        <small class="text-muted">{{ doc.created_at|date:"d/m/Y" }}</small>
                                    </div>
                                    <p class="mb-1"><strong>{{ doc.subject }}</strong> - {{ doc.topic|default:"Aucun sujet" }}</p>
                                    <small>
                                        <span class="badge badge-{{ doc.processing_status|yesno:'success,warning,danger' }}">
                                            {{ doc.get_processing_status_display }}
                                        </span>
                                        - {{ doc.word_count }} mots
                                    </small>
                                </a>
                                {% endfor %}
                            </div>
                            {% else %}
                            <p class="text-muted">Aucun document pour le moment.</p>
                            <a href="{% url 'exercise_generator:document_create' %}" class="btn btn-primary">
                                Créer votre premier document
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <!-- Exercices récents -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-question-circle"></i> Exercices Récents</h5>
                        </div>
                        <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                            {% if recent_exercises %}
                            <div class="list-group">
                                {% for ex in recent_exercises %}
                                <a href="{% url 'exercise_generator:exercise_detail' ex.pk %}" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">{{ ex.concept }}</h6>
                                        <small>
                                            <span class="badge badge-primary">{{ ex.get_exercise_type_display }}</span>
                                            <span class="badge badge-secondary">{{ ex.get_difficulty_display }}</span>
                                        </small>
                                    </div>
                                    <p class="mb-1" style="font-size: 0.9em;">{{ ex.question_text|truncatewords:15 }}</p>
                                    <small class="text-muted">
                                        Qualité: {{ ex.quality_score|floatformat:2 }} - 
                                        <span class="badge badge-{{ ex.status|yesno:'success,warning,danger' }}">
                                            {{ ex.get_status_display }}
                                        </span>
                                    </small>
                                </a>
                                {% endfor %}
                            </div>
                            {% else %}
                            <p class="text-muted">Aucun exercice généré.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
