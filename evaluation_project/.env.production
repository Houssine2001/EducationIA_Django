# ========================================
# CONFIGURATION PRODUCTION - RENDER + MONGODB ATLAS
# ========================================
# IMPORTANT: NE PAS COMMITER CE FICHIER AVEC DES VALEURS RÉELLES !
# Ce fichier sert de template pour les variables d'environnement Render
# ========================================

# ========== DJANGO SETTINGS ==========
# Générez une clé secrète sécurisée avec:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-ici

# Mode DEBUG (TOUJOURS False en production)
DEBUG=False

# Hosts autorisés (séparés par des virgules, SANS ESPACES)
# Exemple: votre-app.onrender.com,www.votre-domaine.com
ALLOWED_HOSTS=votre-app.onrender.com

# CSRF Origins (séparés par des virgules, SANS ESPACES)
# Exemple: https://votre-app.onrender.com,https://www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-app.onrender.com

# ========== MONGODB ATLAS ==========
# Connection String MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# ATTENTION: Remplacez <username>, <password> et <cluster> par vos vraies valeurs
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Nom de la base de données
MONGODB_NAME=django_education_prod

# ========== EMAIL CONFIGURATION (OPTIONNEL) ==========
# Configuration SMTP pour l'envoi d'emails
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre_email@gmail.com
# EMAIL_HOST_PASSWORD=votre_mot_de_passe_app

# ========== HUGGING FACE API (OPTIONNEL) ==========
# Pour utiliser les modèles IA de génération d'exercices
# HUGGINGFACE_API_KEY=votre_cle_api_huggingface

# ========================================
# INSTRUCTIONS POUR RENDER:
# ========================================
# 1. Allez dans votre Dashboard Render
# 2. Sélectionnez votre service web
# 3. Allez dans "Environment"
# 4. Ajoutez chaque variable ci-dessus (une par ligne)
# 5. Cliquez sur "Save Changes"
# 6. Render redémarrera automatiquement votre application
# ========================================
