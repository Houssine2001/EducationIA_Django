# ========================================
# CONFIGURATION LOCALE - DÉVELOPPEMENT
# ========================================
# Ce fichier est utilisé pour le développement local
# Copiez ce fichier en .env pour l'utiliser
# ========================================

# Django Settings
SECRET_KEY=django-insecure-dev-key-changez-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# MongoDB Local
MONGO_HOST=localhost
MONGO_PORT=27017
MONGODB_NAME=django_education
MONGO_USERNAME=
MONGO_PASSWORD=

# Pour MongoDB Atlas (décommentez et configurez si vous utilisez Atlas en dev)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_NAME=django_education_dev
